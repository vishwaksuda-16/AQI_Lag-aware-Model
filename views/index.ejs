/* ══════════════════════════════════════════════
   AQI ARC GAUGE
══════════════════════════════════════════════ */
var aqiCanvas = document.getElementById('aqiArc');
var aqiCtx    = aqiCanvas.getContext('2d');
function drawAQIArc(aqi) {
  var W = aqiCanvas.width, H = aqiCanvas.height;
  aqiCtx.clearRect(0, 0, W, H);
  var cx = W/2, cy = H/2+5, r = 22;
  var start = Math.PI * 0.78, end = Math.PI * 2.22;
  aqiCtx.beginPath(); aqiCtx.arc(cx,cy,r,start,end); aqiCtx.strokeStyle='#1e2a3d'; aqiCtx.lineWidth=5; aqiCtx.lineCap='round'; aqiCtx.stroke();
  var pct = Math.min(aqi/500, 1);
  var color = aqi<=100?'#22c55e':aqi<=200?'#f59e0b':'#ef4444';
  aqiCtx.beginPath(); aqiCtx.arc(cx,cy,r,start, start+pct*(end-start)); aqiCtx.strokeStyle=color; aqiCtx.lineWidth=5; aqiCtx.lineCap='round'; aqiCtx.stroke();
  document.getElementById('liveAQI').style.color = color;
  return color;
}

