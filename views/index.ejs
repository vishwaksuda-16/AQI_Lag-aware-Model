/* ══════════════════════════════════════════════
   NEAREST CITY FALLBACK — Euclidean distance
   Used when a city is not in CITY_COORDS.
══════════════════════════════════════════════ */
function findNearestCity(targetLat, targetLon) {
  var best = null, bestDist = Infinity;
  Object.keys(CITY_COORDS).forEach(function(name) {
    var c = CITY_COORDS[name];
    var d = Math.pow(c[0]-targetLat,2) + Math.pow(c[1]-targetLon,2);
    if (d < bestDist) { bestDist = d; best = name; }
  });
  return best;
}

/* ══════════════════════════════════════════════
   FETCH LIVE WEATHER — Open-Meteo (free, no key)
   Fallback chain:
     1. Exact city in CITY_COORDS
     2. Open-Meteo Geocoding API (resolves any city name)
     3. Nearest city from CITY_COORDS by Euclidean distance
══════════════════════════════════════════════ */
var lastFetchedCity = null;
async function fetchWeather(city) {
  document.getElementById('weatherBody').innerHTML = '<div class="wc-loading">Fetching weather for ' + city + '…</div>';

  var lat, lon, resolvedLabel = city, usingNearest = false;

  // ── Tier 1: exact coords lookup ──
  if (CITY_COORDS[city]) {
    lat = CITY_COORDS[city][0];
    lon = CITY_COORDS[city][1];
  } else {
    // ── Tier 2: Open-Meteo geocoding API ──
    var geoResolved = false;
    try {
      var geoUrl = 'https://geocoding-api.open-meteo.com/v1/search?name='
        + encodeURIComponent(city) + '&count=1&language=en&format=json';
      var geoResp = await fetch(geoUrl);
      if (geoResp.ok) {
        var geoData = await geoResp.json();
        if (geoData.results && geoData.results.length > 0) {
          lat = geoData.results[0].latitude;
          lon = geoData.results[0].longitude;
          resolvedLabel = city + ' (via geocoding)';
          geoResolved = true;
        }
      }
    } catch(e) { /* geocoding failed, continue to tier 3 */ }

    // ── Tier 3: nearest city from CITY_COORDS by Euclidean distance ──
    if (!geoResolved) {
      // No exact or geocoded coords — use geometric centroid of India as reference
      var refLat = 22.5, refLon = 78.9; // approx centre of India
      var nearest = findNearestCity(refLat, refLon);
      lat = CITY_COORDS[nearest][0];
      lon = CITY_COORDS[nearest][1];
      resolvedLabel = city + ' (nearest: ' + nearest + ')';
      usingNearest = true;
    }
  }

  var url = 'https://api.open-meteo.com/v1/forecast'
    + '?latitude='  + lat
    + '&longitude=' + lon
    + '&current=temperature_2m,relative_humidity_2m,apparent_temperature,wind_speed_10m,weather_code,precipitation,uv_index'
    + '&timezone=auto';

  try {
    var response = await fetch(url);
    if (!response.ok) throw new Error('HTTP ' + response.status);
    var data = await response.json();
    var c = data.current;
    renderWeatherWidget(resolvedLabel, c, lat, lon, usingNearest);
    lastFetchedCity = city;
  } catch(e) {
    document.getElementById('weatherBody').innerHTML =
      '<div class="wc-error">⚠ Could not load weather data.<br><span style="color:var(--muted);font-size:0.65rem">' + e.message + '</span></div>';
  }
}

function renderWeatherWidget(label, c, lat, lon, usingNearest) {
  var wi       = wmoInfo(c.weather_code);
  var temp     = Math.round(c.temperature_2m);
  var feels    = Math.round(c.apparent_temperature);
  var humidity = c.relative_humidity_2m;
  var wind     = Math.round(c.wind_speed_10m);
  var uv       = (c.uv_index !== undefined && c.uv_index !== null) ? Number(c.uv_index).toFixed(1) : '—';
  var precip   = (c.precipitation !== undefined && c.precipitation !== null) ? c.precipitation + ' mm' : '—';
  var now      = new Date();
  var timeStr  = String(now.getHours()).padStart(2,'0') + ':' + String(now.getMinutes()).padStart(2,'0');
  var coordStr = Number(lat).toFixed(2) + '°N ' + Number(lon).toFixed(2) + '°E';
  var nearestNote = usingNearest
    ? '<div style="font-family:var(--mono);font-size:0.56rem;color:var(--med);margin-top:0.4rem">⚠ Exact coordinates not found — showing nearest city data</div>'
    : '';

  document.getElementById('weatherBody').innerHTML =
    '<div class="weather-card-bg">' +
      '<div class="wc-city">' + label + ' &nbsp;·&nbsp; ' + DAYS[now.getDay()] + '</div>' +
      '<div class="wc-main">' +
        '<div class="wc-icon">' + wi[0] + '</div>' +
        '<div>' +
          '<div class="wc-temp-big">' + temp + '<sup>°C</sup></div>' +
          '<div class="wc-desc">' + wi[1] + '</div>' +
        '</div>' +
      '</div>' +
      '<div class="wc-stats">' +
        '<div class="wc-stat"><div class="wc-stat-lbl">Feels Like</div><div class="wc-stat-val">' + feels + '°C</div></div>' +
        '<div class="wc-stat"><div class="wc-stat-lbl">Humidity</div><div class="wc-stat-val">' + humidity + '%</div></div>' +
        '<div class="wc-stat"><div class="wc-stat-lbl">Wind Speed</div><div class="wc-stat-val">' + wind + ' km/h</div></div>' +
        '<div class="wc-stat"><div class="wc-stat-lbl">UV Index</div><div class="wc-stat-val">' + uv + '</div></div>' +
        '<div class="wc-stat"><div class="wc-stat-lbl">Precipitation</div><div class="wc-stat-val">' + precip + '</div></div>' +
        '<div class="wc-stat"><div class="wc-stat-lbl">Condition</div><div class="wc-stat-val" style="color:var(--text)">' + wi[1] + '</div></div>' +
      '</div>' +
      nearestNote +
      '<div class="wc-updated">⟳ Updated ' + timeStr + ' &nbsp;·&nbsp; Open-Meteo API &nbsp;·&nbsp; ' + coordStr + '</div>' +
    '</div>';
}

/* ══════════════════════════════════════════════
   UPDATE STATUS STRIP (AQI, pollutants, risk, trend)
══════════════════════════════════════════════ */
function aqiCategory(aqi) {
  if (aqi<=50)  return 'Good';
  if (aqi<=100) return 'Satisfactory';
  if (aqi<=200) return 'Moderate';
  if (aqi<=300) return 'Poor';
  if (aqi<=400) return 'Very Poor';
  return 'Severe';
}

function updateStatusStrip(city) {
  var data = CITY_DATA[city];
  if (!data) return;
  var l = data.latest || {};
  var aqi  = parseFloat(l['AQI'])   || 0;
  var pm25 = parseFloat(l['PM2.5']) || 0;
  var pm10 = parseFloat(l['PM10'])  || 0;
  var no2  = parseFloat(l['NO2'])   || 0;
  var so2  = parseFloat(l['SO2'])   || 0;

  drawAQIArc(aqi);
  document.getElementById('liveAQI').textContent  = Math.round(aqi);
  document.getElementById('liveAQICat').textContent = aqiCategory(aqi);

  // Pollutant bars (normalised)
  document.getElementById('barPM25').style.width = Math.min(pm25/250*100,100)+'%';
  document.getElementById('barPM10').style.width = Math.min(pm10/350*100,100)+'%';
  document.getElementById('barNO2').style.width  = Math.min(no2/200*100,100)+'%';
  document.getElementById('barSO2').style.width  = Math.min(so2/100*100,100)+'%';
  document.getElementById('valPM25').textContent = pm25 ? Math.round(pm25)+' µg' : '—';
  document.getElementById('valPM10').textContent = pm10 ? Math.round(pm10)+' µg' : '—';
  document.getElementById('valNO2').textContent  = no2  ? Math.round(no2)+'  µg' : '—';
  document.getElementById('valSO2').textContent  = so2  ? Math.round(so2)+'  µg' : '—';

  // 7-day sparkline from lag fields
  var l7 = parseFloat(l['AQI_lag7']) || aqi*0.84;
  var l5 = parseFloat(l['AQI_lag5']) || aqi*0.88;
  var l3 = parseFloat(l['AQI_lag3']) || aqi*0.92;
  var l1 = parseFloat(l['AQI_lag1']) || aqi*0.97;
  drawMiniTrend([l7, l7*1.03, l5, l5*1.02, l3, l3*1.02, l1, aqi]);

  // Risk badge
  var rb  = document.getElementById('liveRiskBadge');
  var rt  = document.getElementById('liveRiskText');
  var rs  = document.getElementById('liveRiskSub');
  rb.className = 'live-risk';
  if (aqi<=100) {
    rb.classList.add('low');  rt.textContent='Low Risk';    rs.textContent='Air quality is acceptable.';
  } else if (aqi<=250) {
    rb.classList.add('med');  rt.textContent='Moderate';   rs.textContent='Sensitive groups at risk.';
  } else {
    rb.classList.add('high'); rt.textContent='High Risk';  rs.textContent='Unhealthy — hospital demand elevated.';
  }
}

/* ══════════════════════════════════════════════
   FILL ALL FORM FIELDS FROM CITY DATA
   Called on every city change, regardless of mode
══════════════════════════════════════════════ */
var FORM_MAP = {
  'AQI':       'AQI',
  'AQI_lag1':  'AQI_lag1',
  'AQI_lag3':  'AQI_lag3',
  'AQI_lag5':  'AQI_lag5',
  'AQI_lag7':  'AQI_lag7',
  'PM25':      'PM2.5',
  'PM25_lag3': 'PM2.5_lag3',
  'PM25_lag7': 'PM2.5_lag7',
  'PM10':      'PM10',
  'NO2':       'NO2',
  'SO2':       'SO2'
};

function fillAllFields(city) {
  var data = CITY_DATA[city];
  if (!data || !data.latest) return;
  var l = data.latest;
  Object.keys(FORM_MAP).forEach(function(fieldId) {
    var dataKey = FORM_MAP[fieldId];
    var el = document.getElementById(fieldId);
    if (!el) return;
    var val = l[dataKey];
    if (val !== undefined && val !== null) {
      el.value = parseFloat(val).toFixed(1);
      el.classList.add('autofilled');
      setTimeout(function(){ el.classList.remove('autofilled'); }, 2000);
    }
  });
  // Update hidden city field
  document.getElementById('cityHidden').value = city;
  // Show "Data Loaded" badge
  var badge = document.getElementById('loadedBadge');
  badge.classList.remove('show');
  requestAnimationFrame(function(){ badge.classList.add('show'); });
}

/* ══════════════════════════════════════════════
   GEO PANEL
══════════════════════════════════════════════ */
function updateGeoPanel() {
  var city = document.getElementById('citySelect').value;
  var data = CITY_DATA[city];
  if (!data) return;
  var rows = [
    ['Elevation (m)', data['Elevation']],
    ['Slope',         data['Slope']],
    ['TPI',           data['TPI']],
    ['Industry Score',data['Industry']]
  ];
  var html = '';
  rows.forEach(function(r) {
    html += '<div class="info-row"><div class="info-key">'+r[0]+'</div>' +
            '<div class="info-val">'+(r[1]!==undefined?r[1]:'—')+'</div></div>';
  });
  document.getElementById('geoContent').innerHTML = html;
}

/* ══════════════════════════════════════════════
   ON CITY CHANGE — wire everything together
══════════════════════════════════════════════ */
function onCityChange() {
  var city = document.getElementById('citySelect').value;
  updateStatusStrip(city);
  fillAllFields(city);
  updateGeoPanel();
  fetchWeather(city);
}

/* ── Init on first load ── */
(function init() {
  var initCity = document.getElementById('citySelect').value;
  renderSeasonWidget();
  updateStatusStrip(initCity);
  fillAllFields(initCity);
  updateGeoPanel();
  fetchWeather(initCity);
})();

