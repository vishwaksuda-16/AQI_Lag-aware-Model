/* ──────────────────────────────────────────────
   getCurrentSeason() — IMD India Season Logic
   Reference: India Meteorological Department
   Month: 0 = January … 11 = December
────────────────────────────────────────────── */
function getCurrentSeason() {
  var m = new Date().getMonth(); // 0-indexed
  // Winter:       December(11), January(0), February(1)
  if (m === 11 || m === 0 || m === 1) return 'Winter';
  // Pre-Monsoon:  March(2), April(3), May(4)
  if (m >= 2 && m <= 4)              return 'Pre-Monsoon';
  // SW Monsoon:   June(5), July(6), August(7), September(8)
  if (m >= 5 && m <= 8)              return 'Monsoon';
  // Post-Monsoon: October(9), November(10)
  return 'Post-Monsoon';
}


function renderSeasonWidget() {
  var name = getCurrentSeason();
  var s = SEASON_DATA[name];
  var wrap = document.getElementById('seasonSvgWrap');
  wrap.className = 'season-svg-wrap ' + s.cls;
  wrap.innerHTML = s.svg;
  document.getElementById('seasonName').textContent  = name;
  document.getElementById('seasonName').style.color  = s.color;
  document.getElementById('seasonMonth').textContent = s.months;
  document.getElementById('seasonDesc').textContent  = s.desc;
}

